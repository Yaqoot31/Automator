# Runtime & Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Security & Session Signing (set strong random strings >= 32 chars in production)
SESSION_SECRET=replace-with-32-char-random-session-secret
SECRETS_ENCRYPTION_KEY=replace-with-32-char-random-vault-key

# Firebase Server / Project Override (optional when firebase-applet-config.json is present)
FIREBASE_PROJECT_ID=

# AI Assistant (server-side Gemini API key; never prefix with VITE_)
GEMINI_API_KEY=

# Optional Headless Browser Binary Path (falls back to HTTP + Cheerio when unset on serverless)
CHROMIUM_EXECUTABLE_PATH=